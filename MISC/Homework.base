views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Fall-2025-BSME-CSULB/MISC/HW")
        - submitted != "T"
    order:
      - file.name
      - due
      - tags
      - submitted
      - src
    sort:
      - property: due
        direction: ASC
    columnSize:
      note.tags: 66
